# Copy to your secrets manager / ECS task definition. NEVER commit real values.
SPRING_PROFILES_ACTIVE=postgres,prod
DB_URL=jdbc:postgresql://your-rds-endpoint:5432/academy
DB_USER=academy
DB_PASSWORD=
FRONTEND_URL=https://www.your-academy.com
JWT_SECRET=           # 64+ random characters:  openssl rand -base64 64
MEDIA_SECRET=         # openssl rand -base64 32
ADMIN_EMAIL=you@your-academy.com
ADMIN_PASSWORD=       # change after first login
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-academy.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UPLOAD_DIR=/uploads
